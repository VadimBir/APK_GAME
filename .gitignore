# Vendored Pocket Pal fork: regenerated by scripts/fork-pocketpal.sh + apply-graft.sh.
# We track only OUR sources: app/graft (the graft kit) and app/autocheck. Everything
# else under app/ is upstream + materialized output and stays out of git.
/app/*
!/app/graft
!/app/autocheck
